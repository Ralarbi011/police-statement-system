# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Core ---
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ALLOWED_HOSTS=statements.example.local
CSRF_TRUSTED_ORIGINS=https://statements.example.local
TIME_ZONE=Africa/Accra
SYSTEM_NAME=Police Statement Management System

# --- Database (production must use PostgreSQL) ---
DB_ENGINE=postgres
DB_NAME=police_statements
DB_USER=police_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Storage for evidence/attachments (outside the web root, backed up) ---
MEDIA_ROOT=D:/police-data/media
MAX_ATTACHMENT_SIZE_MB=25

# --- Security ---
SESSION_TIMEOUT_SECONDS=1800
AXES_FAILURE_LIMIT=5
SECURE_SSL_REDIRECT=True

# --- Statement wording (adjust to your jurisdiction's official caution) ---
# STATEMENT_CAUTION_TEXT=You are not obliged to say anything ...
